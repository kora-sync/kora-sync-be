### 9.12 Realized cash flow, 2025-03-01 to 2025-03-05 (200)
GET {{host}}/api/companies/{{companyA}}/cash-flow/realized?from=2025-03-01&to=2025-03-05

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.test("5 days, starting at from", function () {
        client.assert(response.body.days.length === 5, "got " + response.body.days.length);
        client.assert(response.body.days[0].date === "2025-03-01");
    });
    client.test("totals: in 600, out 150, net 450", function () {
        client.assert(response.body.totalInflow === 600, "inflow " + response.body.totalInflow);
        client.assert(response.body.totalOutflow === 150, "outflow " + response.body.totalOutflow);
        client.assert(response.body.net === 450, "net " + response.body.net);
    });
    client.test("day without movement is zero", function () {
        client.assert(response.body.days[0].inflow === 0 && response.body.days[0].cumulativeNet === 0);
    });
    client.test("03-02: in 300, cumulative 300", function () {
        client.assert(response.body.days[1].inflow === 300 && response.body.days[1].cumulativeNet === 300);
    });
    client.test("03-03: out 150, net -150, cumulative 150", function () {
        client.assert(response.body.days[2].outflow === 150);
        client.assert(response.body.days[2].net === -150);
        client.assert(response.body.days[2].cumulativeNet === 150);
    });
    client.test("03-04: in 300, cumulative 450", function () {
        client.assert(response.body.days[3].inflow === 300 && response.body.days[3].cumulativeNet === 450);
    });
    client.test("03-05: cumulative stays 450", function () { client.assert(response.body.days[4].cumulativeNet === 450); });
    client.test("by payment method: CASH, PIX, BANK_TRANSFER", function () {
        var m = response.body.byPaymentMethod;
        client.assert(m.length === 3, "got " + m.length);
        client.assert(m[0].paymentMethod === "CASH" && m[0].inflow === 100 && m[0].outflow === 0);
        client.assert(m[1].paymentMethod === "PIX" && m[1].inflow === 500);
        client.assert(m[2].paymentMethod === "BANK_TRANSFER" && m[2].outflow === 150 && m[2].inflow === 0);
    });
%}

### 9.13 Forecast cash flow, 2031-03-01 to 2031-03-07 (200)
GET {{host}}/api/companies/{{companyA}}/cash-flow/forecast?from=2031-03-01&to=2031-03-07

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.test("7 days", function () { client.assert(response.body.days.length === 7, "got " + response.body.days.length); });
    client.test("totals: in 280, out 370, net -90", function () {
        client.assert(response.body.totalInflow === 280, "inflow " + response.body.totalInflow);
        client.assert(response.body.totalOutflow === 370, "outflow " + response.body.totalOutflow);
        client.assert(response.body.net === -90, "net " + response.body.net);
    });
    client.test("03-02: R1 remaining 200 + R3 80 in, P1 remaining 250 out", function () {
        client.assert(response.body.days[1].inflow === 280, "inflow " + response.body.days[1].inflow);
        client.assert(response.body.days[1].outflow === 250, "outflow " + response.body.days[1].outflow);
        client.assert(response.body.days[1].cumulativeNet === 30);
    });
    client.test("03-03: canceled entry is ignored", function () { client.assert(response.body.days[2].outflow === 0); });
    client.test("03-04: settled entry is ignored", function () { client.assert(response.body.days[3].inflow === 0); });
    client.test("03-05: P2 120 out, cumulative -90", function () {
        client.assert(response.body.days[4].outflow === 120);
        client.assert(response.body.days[4].cumulativeNet === -90);
    });
%}

