### 2.1 Create customer in A (201)
POST {{host}}/api/companies/{{companyA}}/customers
Content-Type: application/json

{
  "name": "Maria Souza",
  "document": "529.982.247-25",
  "email": "maria@email.com",
  "phone": "(11) 99999-0000"
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.test("document normalized", function () { client.assert(response.body.document === "52998224725"); });
    client.global.set("customerA", response.body.id);
%}

