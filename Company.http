################################################################
# 4. PRODUCTS
################################################################

### 4.1 Create rice, KG with minimum stock (201)
POST {{host}}/api/companies/{{companyA}}/products
Content-Type: application/json

{
  "sku": "Arroz",
  "name": "Arroz",
  "description": "Arroz branco tipo 1",
  "unit": "KG",
  "costPrice": 4.50,
  "salePrice": 6.90,
  "minimumStock": 5
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.test("sku lowercase", function () { client.assert(response.body.sku === "arroz", "got " + response.body.sku); });
    client.test("stock starts at zero", function () { client.assert(response.body.stockQuantity === 0); });
    client.test("lowStock true", function () { client.assert(response.body.lowStock === true); });
    client.global.set("productRice", response.body.id);
%}

### 4.2 Create pen, UN without minimum (201)
POST {{host}}/api/companies/{{companyA}}/products
Content-Type: application/json

{
  "sku": "caneta",
  "name": "Caneta azul",
  "unit": "UN",
  "salePrice": 2.50
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.test("lowStock false", function () { client.assert(response.body.lowStock === false); });
    client.global.set("productPen", response.body.id);
%}

