################################################################
# 5. STOCK MOVEMENTS (rice, KG)
################################################################

### 5.1 Entry of 20 (201)
POST {{host}}/api/companies/{{companyA}}/products/{{productRice}}/stock-movements
Content-Type: application/json

{
  "movementType": "ENTRY",
  "quantity": 20,
  "reason": "Initial purchase"
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.test("quantity +20", function () { client.assert(response.body.quantity === 20); });
    client.test("balance 20", function () { client.assert(response.body.balanceAfter === 20); });
%}

### 5.2 Fractional exit of 17.5 (201)
POST {{host}}/api/companies/{{companyA}}/products/{{productRice}}/stock-movements
Content-Type: application/json

{
  "movementType": "EXIT",
  "quantity": 17.5,
  "reason": "Sale"
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.test("quantity -17.5", function () { client.assert(response.body.quantity === -17.5, "got " + response.body.quantity); });
    client.test("balance 2.5", function () { client.assert(response.body.balanceAfter === 2.5, "got " + response.body.balanceAfter); });
%}

### 5.3 Exit larger than balance (409)
POST {{host}}/api/companies/{{companyA}}/products/{{productRice}}/stock-movements
Content-Type: application/json

{
  "movementType": "EXIT",
  "quantity": 3
}

> {% client.test("409 Conflict", function () { client.assert(response.status === 409, "got " + response.status); }); %}

