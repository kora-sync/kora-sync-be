# 7. FINANCIAL ENTRIES
################################################################

### 7.1 Create a customer for the financial tests (201)
POST {{host}}/api/companies/{{companyA}}/customers
Content-Type: application/json

{
  "name": "Cliente Financeiro",
  "document": "390.533.447-05",
  "email": "financeiro@cliente.com",
  "phone": "11977778888"
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.global.set("finCustomer", response.body.id);
%}

### 7.2 Create a supplier for the financial tests (201)
POST {{host}}/api/companies/{{companyA}}/suppliers
Content-Type: application/json

{
  "name": "Fornecedor Financeiro",
  "document": "11.222.333/0001-81",
  "email": "financeiro@fornecedor.com",
  "phone": "11966667777"
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.global.set("finSupplier", response.body.id);
%}

### 7.3 Create receivable with customer (201)
POST {{host}}/api/companies/{{companyA}}/financial-entries
Content-Type: application/json

{
  "entryType": "RECEIVABLE",
  "customerId": "{{finCustomer}}",
  "description": "Order #1042 - 10 kg of rice",
  "amount": 150.00,
  "dueDate": "2030-01-15"
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.test("starts OPEN", function () { client.assert(response.body.status === "OPEN"); });
    client.test("nothing settled", function () { client.assert(response.body.settledAmount === 0); });
    client.test("remaining equals amount", function () { client.assert(response.body.remainingAmount === 150, "got " + response.body.remainingAmount); });
    client.test("not overdue", function () { client.assert(response.body.overdue === false); });
    client.global.set("entryReceivable", response.body.id);
%}

### 7.4 Create payable with supplier, due in the past (201, overdue)
POST {{host}}/api/companies/{{companyA}}/financial-entries
Content-Type: application/json

{
  "entryType": "PAYABLE",
  "supplierId": "{{finSupplier}}",
  "description": "Flour purchase",
  "amount": 800.50,
  "dueDate": "2020-01-10"
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.test("overdue", function () { client.assert(response.body.overdue === true); });
    client.global.set("entryPayable", response.body.id);
%}

