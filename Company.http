@host = http://localhost:8080

################################################################
# 1. COMPANIES
################################################################

### 1.1 Create company A (201)
POST {{host}}/api/companies
Content-Type: application/json

{
  "name": "Padaria Kora",
  "legalName": "Padaria Kora LTDA",
  "taxId": "11.222.333/0001-81",
  "email": "contato@padariakora.com.br",
  "phone": "(11) 98765-4321"
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.test("taxId normalized to digits", function () { client.assert(response.body.taxId === "11222333000181"); });
    client.global.set("companyA", response.body.id);
%}

### 1.2 Create company B (201)
POST {{host}}/api/companies
Content-Type: application/json

{
  "name": "Mercado Sync",
  "legalName": "Mercado Sync LTDA",
  "taxId": "11.444.777/0001-61",
  "email": "contato@mercadosync.com.br",
  "phone": "(21) 91234-5678"
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.global.set("companyB", response.body.id);
%}

### 1.3 Duplicate tax id (409)
POST {{host}}/api/companies
Content-Type: application/json

{
  "name": "Outra Padaria",
  "legalName": "Outra Padaria LTDA",
  "taxId": "11222333000181",
  "email": "outra@padaria.com.br",
  "phone": "11911112222"
}

> {% client.test("409 Conflict", function () { client.assert(response.status === 409, "got " + response.status); }); %}

### 1.4 Invalid tax id (400)
POST {{host}}/api/companies
Content-Type: application/json

{
  "name": "Empresa Invalida",
  "legalName": "Empresa Invalida LTDA",
  "taxId": "11222333000199",
  "email": "x@y.com",
  "phone": "11911112222"
}

> {% client.test("400 Bad Request", function () { client.assert(response.status === 400, "got " + response.status); }); %}

### 1.5 List companies (200)
GET {{host}}/api/companies?page=0&size=10

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.test("2 companies", function () { client.assert(response.body.page.totalElements === 2, "got " + response.body.page.totalElements); });
%}

### 1.6 Get company A (200)
GET {{host}}/api/companies/{{companyA}}

> {% client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); }); %}

### 1.7 Update company A (200)
PUT {{host}}/api/companies/{{companyA}}
Content-Type: application/json

{
  "name": "Padaria Kora Centro",
  "legalName": "Padaria Kora LTDA",
  "taxId": "11222333000181",
  "email": "contato@padariakora.com.br",
  "phone": "11987654321"
}

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.test("name updated", function () { client.assert(response.body.name === "Padaria Kora Centro"); });
%}

### 1.8 Get unknown company (404)
GET {{host}}/api/companies/00000000-0000-0000-0000-000000000000

> {% client.test("404 Not Found", function () { client.assert(response.status === 404, "got " + response.status); }); %}


