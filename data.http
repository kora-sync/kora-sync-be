@host = http://localhost:8080

### 0.1 Reset globals (run the whole file only on an empty database: TRUNCATE companies CASCADE;)
GET {{host}}/v3/api-docs

> {%
    client.global.clearAll();
    client.test("API is up", function () { client.assert(response.status === 200, "got " + response.status); });
%}

### 0.2 Register tenant A (201)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "company": {
    "name": "Tenant A",
    "legalName": "Tenant A LTDA",
    "taxId": "98.765.432/0001-98",
    "email": "contato@tenanta.com",
    "phone": "11900008888"
  },
  "adminName": "Admin A",
  "adminEmail": "admin@tenanta.com",
  "adminPassword": "Sup3r-secret"
}

> {%
    client.test("201 Created (409 means the database is not empty: run TRUNCATE companies CASCADE;)", function () { client.assert(response.status === 201, "got " + response.status); });
    client.global.set("companyA", response.body.user.companyId);
    client.global.set("tokenA", response.body.accessToken);
%}

### 0.3 Register tenant B (201)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "company": {
    "name": "Tenant B",
    "legalName": "Tenant B LTDA",
    "taxId": "10.203.040/0001-94",
    "email": "contato@tenantb.com",
    "phone": "11900009999"
  },
  "adminName": "Admin B",
  "adminEmail": "admin@tenantb.com",
  "adminPassword": "Sup3r-secret"
}

> {%
    client.test("201 Created (409 means the database is not empty: run TRUNCATE companies CASCADE;)", function () { client.assert(response.status === 201, "got " + response.status); });
    client.global.set("companyB", response.body.user.companyId);
    client.global.set("tokenB", response.body.accessToken);
%}

### 0.4 Renew token A (use it when the 15 minutes expire)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@tenanta.com",
  "password": "Sup3r-secret"
}

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.global.set("tokenA", response.body.accessToken);
%}

### 0.5 Renew token B (use it when the 15 minutes expire)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@tenantb.com",
  "password": "Sup3r-secret"
}

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.global.set("tokenB", response.body.accessToken);
%}

################################################################
# 1. COMPANY (the company of the signed-in user)
################################################################

### 1.1 Get my company, tenant A (200)
GET {{host}}/api/company
Authorization: Bearer {{tokenA}}

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.test("it is tenant A", function () {
        client.assert(response.body.id === client.global.get("companyA"), "got " + response.body.id);
        client.assert(response.body.name === "Tenant A", "got " + response.body.name);
        client.assert(response.body.taxId === "98765432000198", "got " + response.body.taxId);
    });
%}

### 1.2 Get my company, tenant B (200, each token sees its own company)
GET {{host}}/api/company
Authorization: Bearer {{tokenB}}

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.test("it is tenant B", function () {
        client.assert(response.body.id === client.global.get("companyB"), "got " + response.body.id);
        client.assert(response.body.name === "Tenant B", "got " + response.body.name);
    });
%}

### 1.3 Update my company (200)
PUT {{host}}/api/company
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "name": "Tenant A Matriz",
  "legalName": "Tenant A LTDA",
  "taxId": "98.765.432/0001-98",
  "email": "contato@tenanta.com",
  "phone": "(11) 90000-8888"
}

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.test("name updated, tax id unchanged", function () {
        client.assert(response.body.name === "Tenant A Matriz", "got " + response.body.name);
        client.assert(response.body.taxId === "98765432000198", "got " + response.body.taxId);
    });
%}

