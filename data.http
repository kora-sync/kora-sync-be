### 15.13 Sessions opened before the change were revoked (401)
POST {{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{pwdRefresh}}"
}

> {% client.test("401 Unauthorized", function () { client.assert(response.status === 401, "got " + response.status); }); %}

