### 12.12 Swagger no longer exposes companyId on operational endpoints (200)
GET {{host}}/v3/api-docs

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.test("flat URLs, no companyId parameter", function () {
        var paths = Object.keys(response.body.paths);
        client.assert(paths.indexOf("/api/customers") >= 0, "missing /api/customers");
        client.assert(paths.indexOf("/api/cash-flow/realized") >= 0, "missing /api/cash-flow/realized");
        var nested = paths.filter(function (p) { return p.indexOf("{companyId}") >= 0; });
        client.assert(nested.length === 0, "still nested: " + nested.join(", "));
        var names = (response.body.paths["/api/customers"].get.parameters || []).map(function (p) { return p.name; });
        client.assert(names.indexOf("companyId") === -1, "companyId still listed as a parameter");
    });
%}

