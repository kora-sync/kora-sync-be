%}

### 15.4 The history shows the author (200)
GET {{host}}/api/products/{{productRice}}/stock-movements?size=1
Authorization: Bearer {{tokenA}}

> {%
    client.test("newest movement has its author", function () {
        client.assert(response.body.data[0].createdBy === client.global.get("adminAId"), "got " + response.body.data[0].createdBy);
    });
%}

### 15.5 The operator registers a settlement, author is recorded (201)
POST {{host}}/api/financial-entries/{{entryPayable}}/settlements
Authorization: Bearer {{operatorToken}}
Content-Type: application/json

{
  "amount": 5.00,
  "paymentMethod": "CASH"
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.test("createdBy is the operator", function () {
        client.assert(response.body.createdBy === client.global.get("operatorId"), "got " + response.body.createdBy);
    });
%}

### 15.6 Create a user to test the password change (201)
POST {{host}}/api/users
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "name": "Pwd User",
  "email": "pwd@tenanta.com",
  "password": "Sup3r-secret",
  "role": "OPERATOR"
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
