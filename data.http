# ---------------------------------------------------------------
# 10. AUTHENTICATION
# ---------------------------------------------------------------

### 10.1 Register company and administrator (201)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "company": {
    "name": "Auth Test Co",
    "legalName": "Auth Test Co LTDA",
    "taxId": "11.111.111/0001-91",
    "email": "contato@authtest.com",
    "phone": "(11) 90000-1111"
  },
  "adminName": "  Ana Souza  ",
  "adminEmail": "Admin@AuthTest.com",
  "adminPassword": "Sup3r-secret"
}

> {%
    client.test("201 Created", function () { client.assert(response.status === 201, "got " + response.status); });
    client.test("token returned", function () {
        client.assert(response.body.accessToken && response.body.accessToken.length > 20);
        client.assert(response.body.tokenType === "Bearer");
        client.assert(response.body.expiresIn === 900, "got " + response.body.expiresIn);
    });
    client.test("user is ADMIN with normalized data", function () {
        client.assert(response.body.user.role === "ADMIN");
        client.assert(response.body.user.email === "admin@authtest.com", "got " + response.body.user.email);
        client.assert(response.body.user.name === "Ana Souza", "got " + response.body.user.name);
    });
    client.test("password never returned", function () {
        client.assert(response.body.user.passwordHash === undefined && response.body.user.password === undefined);
    });
    client.global.set("authToken", response.body.accessToken);
    client.global.set("authCompanyId", response.body.user.companyId);
%}

