# ---------------------------------------------------------------
# 15. ERRORS AS PROBLEMDETAIL, AUTHOR OF OPERATIONS AND PASSWORD CHANGE
# ---------------------------------------------------------------

### 15.1 Missing token returns a ProblemDetail (401)
GET {{host}}/api/customers

> {%
    client.test("401 Unauthorized", function () { client.assert(response.status === 401, "got " + response.status); });
    client.test("problem+json body", function () {
        client.assert(response.contentType.mimeType === "application/problem+json", "got " + response.contentType.mimeType);
        client.assert(response.body.status === 401, "status " + response.body.status);
        client.assert(response.body.title === "Unauthorized", "title " + response.body.title);
    });
    client.test("WWW-Authenticate header is kept", function () {
        client.assert(String(response.headers.valueOf("WWW-Authenticate")).indexOf("Bearer") === 0);
    });
%}

### 15.2 Forged token returns a ProblemDetail too (401)
GET {{host}}/api/customers
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ4In0.invalidsignature

> {%
    client.test("401 Unauthorized", function () { client.assert(response.status === 401, "got " + response.status); });
    client.test("problem+json body", function () {
        client.assert(response.contentType.mimeType === "application/problem+json", "got " + response.contentType.mimeType);
        client.assert(response.body.title === "Unauthorized");
    });
    client.test("WWW-Authenticate header is kept", function () {
        client.assert(String(response.headers.valueOf("WWW-Authenticate")).indexOf("Bearer") === 0);
    });
%}

