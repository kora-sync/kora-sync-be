%}

### 15.7 That user signs in (200)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "pwd@tenanta.com",
  "password": "Sup3r-secret"
}

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.global.set("pwdToken", response.body.accessToken);
    client.global.set("pwdRefresh", response.body.refreshToken);
%}

