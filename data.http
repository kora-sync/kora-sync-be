### 11.1 Login returns a refresh token (200)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@authtest.com",
  "password": "Sup3r-secret"
}

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.test("refresh token returned", function () {
        client.assert(response.body.refreshToken && response.body.refreshToken.length >= 40);
        client.assert(response.body.refreshExpiresIn === 604800, "got " + response.body.refreshExpiresIn);
    });
    client.global.set("refreshToken1", response.body.refreshToken);
    client.global.set("accessToken1", response.body.accessToken);
%}

### 11.2 Refresh with token 1 (200, rotated)
POST {{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken1}}"
}

> {%
    client.test("200 OK", function () { client.assert(response.status === 200, "got " + response.status); });
    client.test("new refresh token is different", function () {
        client.assert(response.body.refreshToken !== client.global.get("refreshToken1"));
        client.assert(response.body.accessToken && response.body.accessToken.length > 20);
    });
    client.global.set("refreshToken2", response.body.refreshToken);
    client.global.set("authToken", response.body.accessToken);
%}

